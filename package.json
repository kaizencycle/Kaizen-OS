{
  "name": "mobius-systems",
  "version": "1.0.0",
  "packageManager": "npm@10.9.4",
  "description": "Mobius Systems - Continuous Integrity Architecture Monorepo implementing the Kaizen Turing Test (KTT)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "sentinels/*",
    "labs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:frontend": "turbo run dev --filter='./apps/*' --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "ci": "turbo run build test",
    "compose:up": "docker compose -f infra/docker/compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/compose.yml down",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "dev:attest": "cd apps/api_attest && uvicorn main:app --host 0.0.0.0 --port 8082 --reload",
    "atlas:audit": "npm run build --workspace=packages/atlas-sentinel && node -e \"require('./packages/atlas-sentinel/dist')\"",
    "sentinel:health": "bash scripts/sentinel-health.sh",
    "integrity:report": "./scripts/integrity-report.sh",
    "integrity:check": "./scripts/integrity-report.sh",
    "consensus:validate": "./scripts/gi-consensus-validate.sh",
    "seed:habits": "tsx scripts/seed-mobius-habits.ts",
    "gi:validate": "./scripts/gi-consensus-validate.sh",
    "console": "cd apps/console && python main.py",
    "docs:generate": "echo \"Documentation generation coming soon\"",
    "dev:ledger": "npm run dev --workspace=@civic/ledger-service",
    "dev:epoch-burn": "npm run dev --workspace=@civic/epoch-burn-service",
    "oc:login": "opencode login",
    "oc:index": "opencode index",
    "oc:dev": "opencode dev --port 4317",
    "oc:review": "opencode review --config opencode.config.yaml",
    "export:catalog": "tsx scripts/exportCatalog.ts",
    "echo-bot": "node scripts/echo-bot.mjs",
    "echo-bot:catalog": "node scripts/echo-bot.mjs --catalog-only --commit",
    "mobius-bot": "node scripts/mobius-bot.mjs",
    "mcp:build": "cd mcp/mobius-repo-scanner && npm run build",
    "mcp:start": "cd mcp/mobius-repo-scanner && npm start",
    "cycle:validate": "node scripts/validate_cycle_journal.mjs",
    "cycle:render": "node scripts/render_cycle_markdown.mjs",
    "cycle:check": "npm run cycle:validate && npm run cycle:render",
    "benchmark": "vitest bench --run",
    "benchmark:ci": "vitest bench --run",
    "benchmark:baseline": "vitest bench --reporter=json --outputFile=tests/benchmarks/.baselines/current.json",
    "test:coverage": "turbo run test -- --coverage",
    "journals:validate": "npx tsx scripts/validate-journals.ts",
    "journals:index": "npx tsx scripts/generate-cycle-journal-index.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.1",
    "turbo": "^2.10.4",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kaizencycle/Mobius-Substrate.git"
  },
  "keywords": [
    "mobius-systems",
    "kaizen-turing-test",
    "ktt",
    "mii",
    "mic",
    "monorepo",
    "integrity",
    "ledger",
    "oaa",
    "continuous-improvement",
    "dva"
  ],
  "author": "Kaizen Cycle",
  "license": "MIT"
}
