    "**/*.md",
    "*.md",
    "examples/**",
    "assets/**",
    "archive/**",
    "badges/**",
    "grafana/**"
  ],
  "EP-2": [
    "apps/**",
    "packages/**",
    "labs/**",
    "configs/**",
    "scripts/**",
    "tests/**",
    "test/**",
    "infra/**",
    "mesh/**",
    "mii/**",
    "catalog/**",
    "data/**",
    "mcp/**",
    "package.json",
    "pnpm-lock.yaml",
    "mkdocs.yml"
  ],
  "EP-3": [
    "docs/epicon/**",
    "docs/specs/**",
    "schemas/**",
    "journals/**",
    "sentinels/**",
    "agents/**",
    "canon/**",
    "accords/**",
    "attestations/**",
    "ledger/**",
    "MOBIUS.md",
    "ETHICAL_ADDENDUM.md",
    "cycle.json",
