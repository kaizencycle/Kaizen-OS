{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/kaizencycle/Mobius-Substrate/main/schemas/mobius_pulse.schema.json",
  "title": "Mobius Pulse (ledger/mobius-pulse.json)",
  "description": "Schema for the derived pulse file consumed read-only by HIVE and browser-shell. Introduced C-339.",
  "type": "object",
  "required": ["schema", "updated_at", "cycle"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "MOBIUS_PULSE_V1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cycle": {
      "type": "string",
      "pattern": "^C-[0-9]+$"
    },
    "cycle_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "live_nodes": { "type": "integer", "minimum": 0 },
        "total_entries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "network_mii": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "terminal_snapshot": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "gi": { "type": "number", "minimum": 0, "maximum": 1 },
        "mode": { "type": "string", "enum": ["green", "yellow", "red"] },
        "cycle": { "type": "string", "pattern": "^C-[0-9]+$" }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
