{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobius-substrate.com/schemas/fountain-state.v0_1.json",
  "title": "Fountain State",
  "description": "Federation Fountain eligibility state machine. GI95 is provisional — not an automatic MIC mint trigger.",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "gi_value",
    "gi_confidence",
    "observed_at",
    "weight_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "state": {
      "type": "string",
      "enum": [
        "DORMANT",
        "OBSERVING",
        "APPROACHING",
        "AUDIT_REQUIRED",
        "PROVISIONAL_GI95",
        "SUSTAINED_GI95",
        "REVIEW_WINDOW_OPEN",
        "QUARANTINED",
        "CLOSED"
      ]
    },
    "gi_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gi_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sustained_cycles_required": {
      "type": "integer",
      "minimum": 1
    },
    "sustained_cycles_observed": {
      "type": "integer",
      "minimum": 0
    },
    "provisional_since": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "review_window": {
      "type": "object",
      "properties": {
        "opened_at": { "type": ["string", "null"], "format": "date-time" },
        "closes_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_required", "pending", "in_progress", "passed", "failed"]
        },
        "weight_frozen": { "type": "boolean" },
        "adversarial_replay": {
          "type": "string",
          "enum": ["not_started", "in_progress", "passed", "failed"]
        },
        "holdout_review": {
          "type": "string",
          "enum": ["not_started", "in_progress", "passed", "failed"]
        }
      }
    },
    "quarantine": {
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "since": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "weight_version": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_message": {
      "type": "string",
      "description": "Operator-safe public copy; must not expose farming recipes"
    }
  }
}
