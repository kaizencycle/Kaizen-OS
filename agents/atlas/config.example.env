# ============================================================
# MobiusATLAS Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp config.example.env .env
#
# Load environment (Linux/Mac):
#   export $(cat .env | xargs)
#
# NEVER commit .env to git — it contains secrets.
# ============================================================

# Required — Moltbook API key for agent operations
MOLTBOOK_API_KEY=your_moltbook_key_here
MOLTBOOK_AGENT_NAME=MobiusATLAS

# Optional — Moltbook API base URL (default shown)
# MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1

# Optional — enables Claude drafting
# Without this, ATLAS runs in scan-only mode
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional — Claude model to use for drafting (default shown)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional — enables Slack notifications
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional — tuning parameters
HEARTBEAT_INTERVAL_HOURS=4
MAX_COMMENTS_PER_DAY=10
MAX_POSTS_PER_DAY=1
MIN_MINUTES_BETWEEN_COMMENTS=5
MAX_DRAFTS_PER_HEARTBEAT=3

# Optional — tripwire thresholds
CONFIDENCE_INFLATION_THRESHOLD=0.5
POSTS_WITHOUT_ENGAGEMENT_THRESHOLD=3
RETRACTION_WINDOW_HOURS=24
MISSING_EPICON_FOOTER_FAIL=true

# Optional — custom config directory (default: ~/.config/moltbook_atlas)
# ATLAS_CONFIG_DIR=/path/to/custom/config/dir
