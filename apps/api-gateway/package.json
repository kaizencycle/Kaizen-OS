{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "Mobius Systems API Gateway - Unified routing and middleware",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:vercel": "echo 'Vercel handles TypeScript compilation for api/ directory'",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src api --ext .ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@civic/integrity-core": "*",
    "@civic/shield-policies": "*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vercel/node": "^5.8.16",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "eslint-config-next": "14.2.35",
    "ethers": "6.16.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.3",
    "next": "14.2.35"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^25.9.3",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
