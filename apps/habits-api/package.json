{
  "name": "@mobius/habits-api",
  "version": "1.0.0",
  "description": "Mobius Habits API - Daily Reflections + Citizen Shield",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "node dist/index.js",
    "clean": "rm -rf dist frontend/.next",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@civic/integrity-core": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.3.1",
    "eslint-config-next": "14.2.35",
    "ethers": "6.17.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "next": "14.2.35",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  }
}
