{
  "name": "@civic/ledger-service",
  "version": "1.0.0",
  "description": "Civic Ledger Service - Value layer API for integrity economy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "echo 'Tests require built dependencies - run after full build' && exit 0",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:recreate": "tsx src/db/migrate.ts --recreate"
  },
  "dependencies": {
    "@civic/integrity-units": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "eslint-config-next": "14.2.35",
    "ethers": "6.17.0",
    "express": "^4.18.2",
    "next": "14.2.35",
    "pg": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "civic",
    "ledger",
    "integrity",
    "economy",
    "api"
  ],
  "author": "Kaizen OS Core Team",
  "license": "MIT"
}
